---
import { tinaField } from '@tinacms/astro/tina-field';
import type { CmsConfig } from '../lib/data';

interface Props {
	config?: CmsConfig | null;
}

const { config } = Astro.props;
const siteName = config?.seo?.title ?? 'AgenticDraft';
const siteOwner = config?.seo?.siteOwner ?? siteName;
const logo = config?.seo?.logo ?? '/agenticdraft-mark.png';
---

<footer class="site-footer">
	<div class="footer-brand">
		<img src={logo} alt="" width="44" height="44" /><span>{siteName}</span>
	</div>
	<p data-tina-field={config?.footer ? tinaField(config.footer, 'tagline') : undefined}>
		{config?.footer?.tagline}
	</p>
	<p>© <span id="year"></span> {siteOwner}</p>
</footer>

<script>
	const year = document.getElementById('year');
	if (year) year.textContent = String(new Date().getFullYear());
</script>
