---
import { tinaField } from '@tinacms/astro/tina-field';
import LanguageSwitcher from './LanguageSwitcher.astro';
import type { CmsConfig } from '../lib/data';
import { localeHref, uiStrings, type RouteKey } from '../lib/i18n';

interface Props {
	config?: CmsConfig | null;
	locale?: string;
	/** Which page the header is rendered on, so the switcher can find its
	 * counterpart. Passed explicitly rather than read from `Astro.url`: inside
	 * a Tina island the URL is `/tina-island/global`, not the page's own. */
	route?: RouteKey;
}

const { config, locale = 'en', route = 'home' } = Astro.props;
const ui = uiStrings(locale);
const siteName = config?.seo?.title ?? 'AgenticDraft';
const logo = config?.seo?.logo ?? '/agenticdraft-mark.png';
const navItems = (config?.nav ?? []).filter((item) => item !== null);

// Nav entries are stored as in-page anchors (`#approach`). They only work from
// the home page, so they're resolved against the locale's home path — from
// `/story` the link becomes `/#approach` and navigates home to that section.
const home = localeHref(locale);
const navHref = (link?: string | null) => {
	if (!link) return home;
	return link.startsWith('#') ? `${home}${link}` : link;
};
---

<header class="site-header" data-header>
	<a class="brand" href={home} aria-label={ui.brandHomeAria(siteName)}>
		<img
			src={logo}
			alt=""
			width="54"
			height="54"
			data-tina-field={config?.seo ? tinaField(config.seo, 'logo') : undefined}
		/>
		<span data-tina-field={config?.seo ? tinaField(config.seo, 'title') : undefined}>
			{siteName}
		</span>
	</a>
	<button
		class="menu-button"
		type="button"
		aria-expanded="false"
		aria-controls="site-nav"
		data-label-open={ui.menuOpen}
		data-label-close={ui.menuClose}
	>
		<span class="sr-only" data-menu-label>{ui.menuOpen}</span><i></i><i></i>
	</button>
	<nav id="site-nav" class="site-nav" aria-label={ui.primaryNavAria}>
		{
			navItems.map((item) => (
				<a href={navHref(item.link)} data-tina-field={tinaField(item, 'title')}>
					{item.title}
				</a>
			))
		}
		<LanguageSwitcher {locale} {route} />
		{
			config?.headerCta?.label && (
				<a
					class="nav-cta"
					href={config.headerCta.href ?? '#'}
					data-tina-field={tinaField(config.headerCta, 'label')}
				>
					{config.headerCta.label} <span aria-hidden="true">↗</span>
				</a>
			)
		}
	</nav>
</header>

<script>
	const header = document.querySelector('[data-header]');
	const menuButton = document.querySelector<HTMLElement>('.menu-button');
	const nav = document.querySelector<HTMLElement>('.site-nav');
	const menuLabel = document.querySelector<HTMLElement>('[data-menu-label]');

	if (header) {
		const setHeaderState = () => header.classList.toggle('scrolled', window.scrollY > 18);
		setHeaderState();
		window.addEventListener('scroll', setHeaderState, { passive: true });
	}

	const setMenuState = (open: boolean, returnFocus = false) => {
		if (!menuButton || !menuLabel || !nav) return;
		menuButton.setAttribute('aria-expanded', String(open));
		menuLabel.textContent = open
			? (menuButton.dataset.labelClose ?? 'Close navigation')
			: (menuButton.dataset.labelOpen ?? 'Open navigation');
		nav.classList.toggle('open', open);
		document.body.classList.toggle('menu-open', open);
		if (returnFocus) menuButton.focus();
	};

	if (menuButton && nav) {
		menuButton.addEventListener('click', () => {
			setMenuState(menuButton.getAttribute('aria-expanded') !== 'true');
		});

		nav.addEventListener('click', (event) => {
			if ((event.target as Element).closest('a')) setMenuState(false);
		});

		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && menuButton.getAttribute('aria-expanded') === 'true') {
				setMenuState(false, true);
			}
		});

		document.addEventListener('click', (event) => {
			if (
				menuButton.getAttribute('aria-expanded') === 'true' &&
				!(event.target as Element).closest('.site-header')
			) {
				setMenuState(false);
			}
		});

		const mobileNavQuery = window.matchMedia('(max-width: 720px)');
		const syncNavigation = () => {
			if (!mobileNavQuery.matches) setMenuState(false);
		};
		mobileNavQuery.addEventListener?.('change', syncNavigation);
		syncNavigation();
	}
</script>
