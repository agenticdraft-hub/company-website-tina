---
import { DEFAULT_LOCALE, LOCALES, LOCALE_META, localeHref, uiStrings, type RouteKey } from '../lib/i18n';

interface Props {
	/** The locale currently being rendered. */
	locale?: string;
	/** The page being rendered, so each link points at that page in the other
	 * locale rather than always at the locale's home. */
	route?: RouteKey;
}

const { locale = DEFAULT_LOCALE, route = 'home' } = Astro.props;
const ui = uiStrings(locale);

// The active locale renders as text rather than a link: a page linking to
// itself is a no-op stop for keyboard users and a self-reference for crawlers.
const others = LOCALES.filter((code) => code !== locale);
const current = LOCALE_META[locale as keyof typeof LOCALE_META] ?? LOCALE_META[DEFAULT_LOCALE];
---

<nav class="lang-switch" aria-label={ui.languageNavAria}>
	<span class="lang-switch-current" aria-current="true" lang={current.code}>
		{current.short}<span class="sr-only"> ({current.name})</span>
	</span>
	{
		others.map((code) => (
			<span class="lang-switch-item">
				<span class="lang-switch-sep" aria-hidden="true">
					·
				</span>
				<a href={localeHref(code, route)} lang={LOCALE_META[code].code} hreflang={LOCALE_META[code].code}>
					{LOCALE_META[code].short}
					<span class="sr-only"> ({LOCALE_META[code].name})</span>
				</a>
			</span>
		))
	}
</nav>

<script>
	// The switcher links are static (`/`, `/de/story`, …) — a hash anchor only exists at
	// runtime, so the current one is carried over on click. Switching from
	// `/de/#workflow` then lands on `/#workflow`, not the top of the page.
	//
	// The target is captured once in `base` and never read back from the live
	// `href`: the handler rewrites `href`, and a browser restoring this page from
	// the back/forward cache restores that rewrite along with the heap that holds
	// this closure. Reading `href` back would append the hash a second time
	// (`/#workflow#workflow`), which matches no element and silently lands at the
	// top — the exact behaviour this script exists to prevent.
	document.querySelectorAll<HTMLAnchorElement>('.lang-switch a').forEach((link) => {
		const base = link.getAttribute('href') ?? '';
		link.addEventListener('click', () => {
			link.href = base + window.location.hash;
		});
	});
</script>

<style>
	/* Scoped, not global: this is the one part of the page that wasn't in the
	   original site, so it stays out of the ported stylesheet. Colours and the
	   mono face come from the existing tokens. */
	.lang-switch {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-family: var(--mono);
		font-size: 0.8125rem;
		font-weight: 500;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		white-space: nowrap;
	}

	.lang-switch-item {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
	}

	.lang-switch a,
	.lang-switch-current {
		padding-block: 0.25rem;
		transition: color 0.2s;
	}

	.lang-switch-current {
		color: var(--ink);
	}

	.lang-switch a {
		color: var(--muted);
	}

	.lang-switch a:hover {
		color: var(--ink);
	}

	.lang-switch-sep {
		color: rgba(155, 167, 189, 0.45);
	}
</style>
