---
import Hero from '../sections/Hero.astro';
import Approach from '../sections/Approach.astro';
import Workflow from '../sections/Workflow.astro';
import Closing from '../sections/Closing.astro';
import type { CmsPage } from '../../lib/data';

interface Props {
	data?: CmsPage | null;
}

const { data } = Astro.props;
---

<main id="main">
	<Hero hero={data?.hero} />
	<Approach approach={data?.approach} />
	<Workflow workflow={data?.workflow} />
	<Closing closing={data?.closing} />
</main>
