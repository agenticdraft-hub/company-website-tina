---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import { getConfig } from '../lib/data';
import { islands } from '../lib/islands';

interface Props {
	title: string;
	description: string;
	image?: string;
}

const { title, description, image } = Astro.props;
const config = (await getConfig()).data?.config ?? null;
---

<!doctype html>
<html lang="en" class="no-js">
	<head>
		<BaseHead title={title} description={description} image={image} />
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>
		<TinaIsland name="global" wrapper={islands.global.wrapper}>
			<Header config={config} />
		</TinaIsland>
		<slot />
		<TinaIsland name="global-footer" wrapper={islands['global-footer'].wrapper}>
			<Footer config={config} />
		</TinaIsland>

		<script>
			// Deferred, matching the original site's `script.js` timing: the signal
			// bar in the hero starts hidden and animates in only once JS is running.
			document.documentElement.classList.add('motion-ready');
		</script>
	</body>
</html>
