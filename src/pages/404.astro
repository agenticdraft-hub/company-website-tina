---
import Base from '../layouts/Base.astro';
---

<Base
	title="Page not found — AgenticDraft"
	description="That page isn't here. Head back to the AgenticDraft home page."
>
	<main id="main">
		<section class="closing" aria-labelledby="notfound-title">
			<div class="closing-orb" aria-hidden="true"></div>
			<p class="eyebrow"><span></span> Error 404</p>
			<h2 id="notfound-title">This page drifted<br /><em>out of orbit.</em></h2>
			<a class="button button-primary" href="/">
				Back to home <span aria-hidden="true">→</span>
			</a>
		</section>
	</main>
</Base>
