---
import Base from '../layouts/Base.astro';
import TinaIsland from '@tinacms/astro/TinaIsland.astro';
import PageBody from '../components/islands/PageBody.astro';
import { getConfig, getHome } from '../lib/data';
import { islands } from '../lib/islands';

const page = await getHome();
const data = page.data?.page;
if (!data) return new Response('Not Found', { status: 404 });

const config = (await getConfig()).data?.config ?? null;
---

<Base
	title={data.seoTitle || config?.seo?.title || 'AgenticDraft'}
	description={data.seoDescription ?? config?.seo?.description ?? ''}
>
	<TinaIsland name="page" wrapper={islands.page.wrapper} primary>
		<PageBody data={data} />
	</TinaIsland>
</Base>
